FROM node:22-slim

# Install system utilities and Git
RUN apt-get update && apt-get install -y \
    curl \
    git \
    python3 \
    python3-pip \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install the harness globally (official npm package)
RUN npm install -g --ignore-scripts @juliangruber/harness

COPY entrypoint.juliangruber-harness.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["harness"]
