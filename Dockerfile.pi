FROM node:22-slim

# Install system utilities and Git
RUN apt-get update && apt-get install -y \
    curl \
    git \
    python3 \
    python3-pip \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install Pi globally (official npm package)
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent

# Configure Pi globally inside the container to connect to Host Ollama
RUN mkdir -p /root/.pi/agent && \
    echo '{\n\
  "providers": {\n\
    "ollama": {\n\
      "baseUrl": "http://host.docker.internal:11434/v1",\n\
      "api": "openai-completions",\n\
      "apiKey": "ollama",\n\
      "compat": {\n\
        "supportsDeveloperRole": false,\n\
        "supportsReasoningEffort": false\n\
      },\n\
      "models": [\n\
        {\n\
          "id": "qwen3.6"\n\
        }\n\
      ]\n\
    }\n\
  }\n\
}' > /root/.pi/agent/models.json

WORKDIR /workspace

# Default to starting Pi with the default ollama model
CMD ["pi", "--model", "ollama/qwen3.6"]
